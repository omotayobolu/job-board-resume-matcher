# Shortlistly environment.
# Copy the backend block into backend/.env (the API loads that file).
# Copy the frontend block into frontend/.env (Vite loads that file).

# --- backend/.env ---
DATABASE_URL=postgres://shortlistly:shortlistly@127.0.0.1:5432/shortlistly
JWT_SECRET=replace-me
FRONTEND_URL=http://localhost:5173
PORT=3000
AWS_REGION=us-east-1
S3_BUCKET_NAME=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Job seeker product: public job list, apply, recommendations, and seeker profiles.
# Default off. Set to true or 1 to turn those backend routes back on.
# users.role may still be job_seeker for rows that already exist.
JOB_SEEKER_FEATURES=false

# --- frontend/.env ---
VITE_API_URL=http://localhost:3000/api/v1

# Must match the backend flag. Default off hides job seeker pages and links.
# The page files stay in the repo.
VITE_JOB_SEEKER_FEATURES=false
